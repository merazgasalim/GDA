{
  "name": "gestion-des-arrivages",
  "version": "1.0.0",
  "description": "Application de gestion des arrivages pour professionnels de pièces auto - Suivi des prix et historique",
  "main": "out/main/index.js",
  "author": "MeraPub",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder",
    "build:win": "electron-vite build && electron-builder --win",
    "prebuild": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "build:electron": "electron-vite build"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.11.0",
    "@tanstack/react-virtual": "^3.0.1",
    "better-sqlite3": "^9.2.2",
    "date-fns": "^3.0.6",
    "drizzle-orm": "^0.45.1",
    "electron-store": "^8.1.0",
    "exceljs": "^4.4.0",
    "lodash": "^4.17.21",
    "papaparse": "^5.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "systeminformation": "^5.21.22",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/lodash": "^4.14.202",
    "@types/node": "^20.10.6",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "electron-vite": "^3.1.0",
    "eslint": "^9.39.2",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^1.3.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "asar": true,
    "appId": "com.merapub.gestiondesarrivages",
    "productName": "Gestion des Arrivages",
    "directories": {
      "output": "release",
      "buildResources": "release"
    },
    "npmRebuild": false,
    "compression": "maximum",
    "files": [
      "out/**/*",
      "dist/**/*",
      "!**/*.map",
      "!.github/**",
      "!src/**",
      "!**/__tests__/**",
      "!**/test/**",
      "!**/tests/**",
      "!**/examples/**",
      "!**/docs/**",
      "!**/coverage/**",
      "!**/*.ts"
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
