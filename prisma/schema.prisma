generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Main price entry table - DENORMALIZED BY DESIGN
/// Each row represents a single price observation at a point in time.
/// Entries are IMMUTABLE - never update, only insert new records.
///
/// OPERATIONS LOG INTEGRATION:
/// - operation_id links this entry to its parent operation
/// - is_active allows soft-delete without destroying data
/// - abandonedAt records when the entry was marked inactive
///
/// Query patterns MUST filter by is_active=true AND operation.status=COMPLETED
/// to show only valid, non-abandoned data to users.
model PriceEntry {
  id             String        @id @default(uuid())
  reference      String
  designation    String
  brand          String
  constructorRef String?
  supplierName   String
  supplierPhone  String?
  price          Float
  currency       String        @default("MAD")
  entryDate      DateTime      @default(now())
  arrivageDate   DateTime?
  notes          String?
  importBatchId  String?
  createdAt      DateTime      @default(now())
  /// Links this entry to the operation that created it.
  /// CRITICAL: Every new entry MUST have an operationId.
  /// Legacy entries (before this system) may have null operationId.
  operationId    String?
  /// Whether this entry is currently active (visible in normal queries).
  /// false = entry was part of an abandoned operation
  /// Default true for backwards compatibility with existing data.
  isActive       Boolean       @default(true)
  /// When this entry was marked as inactive (abandoned).
  /// null = entry is active and has never been abandoned
  abandonedAt    DateTime?
  operation      OperationLog? @relation(fields: [operationId], references: [id])

  @@index([reference])
  @@index([designation])
  @@index([brand])
  @@index([supplierName])
  @@index([entryDate])
  @@index([arrivageDate])
  @@index([importBatchId])
  @@index([operationId])
  @@index([isActive])
  @@index([isActive, operationId])
  @@index([reference, brand])
  @@index([supplierName, entryDate])
}

/// Application settings and configuration
model AppSettings {
  id        String   @id @default("main")
  settings  String
  updatedAt DateTime @updatedAt
}

/// Import history for audit trail
/// NOTE: This model is DEPRECATED and will be removed in a future version.
/// All new imports should use the OperationLog system instead.
/// Kept for backwards compatibility with existing import history data.
model ImportLog {
  id           String   @id @default(uuid())
  batchId      String   @unique
  rowCount     Int
  importedAt   DateTime @default(now())
  rawPreview   String?
  status       String   @default("completed")
  errorMessage String?
}

/// Central audit log for all data-modifying operations.
///
/// CRITICAL INVARIANTS:
/// 1. Every data modification MUST have an associated OperationLog entry
/// 2. Operation is created BEFORE any data is inserted
/// 3. Status is PENDING until all writes succeed
/// 4. An operation in PENDING status after app restart indicates a crash
/// and should prompt user for resolution (finalize or abandon)
///
/// This table is APPEND-ONLY for new operations. Only the status field
/// may be updated (PENDING->COMPLETED, COMPLETED->ABANDONED).
model OperationLog {
  id                   String       @id @default(uuid())
  /// Operation type: IMPORT | MANUAL_ADD | BULK_EDIT | BULK_DELETE | SYSTEM_MIGRATE
  type                 String
  /// Status: PENDING | COMPLETED | FAILED | ABANDONED
  status               String       @default("PENDING")
  rowCount             Int          @default(0)
  createdAt            DateTime     @default(now())
  completedAt          DateTime?
  abandonedAt          DateTime?
  createdBy            String       @default("local")
  abandonedBy          String?
  metadata             String?
  description          String?
  abandonedOperationId String?
  priceEntries         PriceEntry[]

  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([abandonedOperationId])
}
