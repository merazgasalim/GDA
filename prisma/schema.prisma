// Prisma Schema for Gestion des Arrivages
// ===========================================
// This schema follows INTENTIONAL DENORMALIZATION principles.
// See: https://www.vertabelo.com/blog/when-to-denormalize-a-database/
//
// DESIGN DECISIONS:
// 1. PriceEntry is the SINGLE main table - denormalized by design
// 2. Each entry is IMMUTABLE - we NEVER update historical data
// 3. Supplier info (name, phone) is stored directly in PriceEntry
//    - Pros: Fast imports, no FK lookups, simpler queries
//    - Cons: Data duplication (acceptable for this use case)
// 4. This is a PRICE MEMORY system, not stock management
//    - We want to answer: "What price did I pay for X from Y on date Z?"
//    - Not: "How many X do I have in stock?"
//
// The denormalization trade-offs are acceptable because:
// - Import speed is critical (bulk paste operations)
// - Data is append-only (no complex update cascades needed)
// - Query patterns are simple (search/filter, not complex joins)
// - Storage is cheap, developer time is expensive

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Main price entry table - DENORMALIZED BY DESIGN
/// Each row represents a single price observation at a point in time.
/// Entries are IMMUTABLE - never update, only insert new records.
model PriceEntry {
  id                  String   @id @default(uuid())
  
  // Product identification
  reference           String   // Part reference number
  designation         String   // Part description/name
  brand               String   // Brand/Marque (e.g., BOSCH, VALEO)
  constructorRef      String?  // OEM/Constructor reference number
  
  // Supplier info - DENORMALIZED (not a separate table)
  // Rationale: Allows flexible import without requiring supplier pre-registration
  // Trade-off: Some duplication, but enables:
  //   - One-step paste import (no FK validation)
  //   - Supplier info captured exactly as received
  //   - Historical supplier name changes preserved
  supplierName        String   // Supplier/vendor name
  supplierPhone       String?  // Supplier contact phone
  
  // Price data
  price               Float    // Unit price at time of entry
  currency            String   @default("MAD") // Currency code
  
  // Temporal data
  entryDate           DateTime @default(now()) // When this price was recorded
  arrivageDate        DateTime? // Date of the arrivage/shipment
  
  // Metadata
  notes               String?  // Optional notes/comments
  importBatchId       String?  // Groups entries from same import
  createdAt           DateTime @default(now())
  
  // Indexes for common query patterns
  @@index([reference])
  @@index([designation])
  @@index([brand])
  @@index([supplierName])
  @@index([entryDate])
  @@index([arrivageDate])
  @@index([importBatchId])
  
  // Composite indexes for filtered searches
  @@index([reference, brand])
  @@index([supplierName, entryDate])
}

/// Application settings and configuration
model AppSettings {
  id        String   @id @default("main")
  settings  String   // JSON blob for flexible settings
  updatedAt DateTime @updatedAt
}

/// Import history for audit trail
model ImportLog {
  id           String   @id @default(uuid())
  batchId      String   @unique
  rowCount     Int
  importedAt   DateTime @default(now())
  rawPreview   String?  // First few rows for reference
  status       String   @default("completed") // completed | partial | failed
  errorMessage String?
}
