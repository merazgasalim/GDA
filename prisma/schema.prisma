datasource db {
  provider = "sqlite"
  // url now set in prisma.config.ts for Prisma 7.x
}

/// Main price entry table - DENORMALIZED BY DESIGN
/// Each row represents a single price observation at a point in time.
/// Entries are IMMUTABLE - never update, only insert new records.
///
/// OPERATIONS LOG INTEGRATION:
/// - operation_id links this entry to its parent operation
/// - is_active allows soft-delete without destroying data
/// - abandonedAt records when the entry was marked inactive
///
/// Query patterns MUST filter by is_active=true AND operation.status=COMPLETED
/// to show only valid, non-abandoned data to users.
model PriceEntry {
  id             String        @id @default(uuid())
  reference      String
  designation    String
  brand          String
  supplierName   String
  supplierPhone  String?
  price          Float
  currency       String        @default("DZD")
  entryDate      DateTime      @default(now())
  arrivageDate   DateTime?
  notes          String?
  importBatchId  String?
  createdAt      DateTime      @default(now())
  createdBy      String        @default("local")
  /// Links this entry to the operation that created it.
  /// CRITICAL: Every new entry MUST have an operationId.
  /// Legacy entries (before this system) may have null operationId.
  operationId    String
  /// Whether this entry is currently active (visible in normal queries).
  /// false = entry was part of an abandoned operation
  /// Default true for backwards compatibility with existing data.
  isActive       Boolean       @default(true)
  /// When this entry was marked as inactive (abandoned).
  /// null = entry is active and has never been abandoned
  abandonedAt    DateTime?
  operation      OperationLog  @relation(fields: [operationId], references: [id])

  @@index([reference])
  @@index([designation])
  @@index([brand])
  @@index([supplierName])
  @@index([entryDate])
  @@index([arrivageDate])
  @@index([importBatchId])
  @@index([operationId])
  @@index([isActive])
  @@index([isActive, operationId])
  @@index([reference, brand])
  @@index([supplierName, entryDate])
}

/// Application settings and configuration
model AppSettings {
  id        String   @id @default("main")
  settings  String
  updatedAt DateTime @updatedAt
}

/// Import history for audit trail
/// NOTE: This model is DEPRECATED and will be removed in a future version.
/// All new imports should use the OperationLog system instead.
/// Kept for backwards compatibility with existing import history data.
model ImportLog {
  id           String   @id @default(uuid())
  batchId      String   @unique
  rowCount     Int
  importedAt   DateTime @default(now())
  rawPreview   String?
  status       String   @default("completed")
  errorMessage String?
}

// ===========================================
// SUPPLIER DOMAIN (CORE ENTITY)
// ===========================================
// Supplier is a core domain object that will be reused across:
// - Imports (linking price entries to normalized suppliers)
// - Pricing history (tracking supplier price patterns)
// - Provenance (auditing data sources)
// - Audit logs (traceability)
//
// Design rationale:
// 1. Contacts are NORMALIZED (not JSON) for queryability and integrity
// 2. Phone/Email are separate types with different validation rules
// 3. Channel is only relevant for PHONE contacts (WhatsApp, Viber, etc.)
// 4. At least ONE phone is REQUIRED (business rule enforced at service layer)
//
// NOTE: SQLite doesn't support enums, so we use String with validation at service layer.
// Valid ContactType values: 'PHONE', 'EMAIL'
// Valid PhoneChannel values: 'REGULAR', 'WHATSAPP', 'VIBER', 'TELEGRAM'

/// Supplier entity - core domain object for supply chain management.
/// 
/// INVARIANTS:
/// - Must have at least one PHONE contact (enforced at service layer)
/// - Name + Address combination uniquely identifies a supplier context
/// - Same name with different addresses is allowed (different branches/locations)
model Supplier {
  id        String   @id @default(uuid())
  name      String   // Required, min 2 chars, trimmed
  address   String   // Required, min 5 chars
  website   String?  // Optional, must be valid URL if present
  createdAt DateTime @default(now())
  createdBy String   @default("local")
  updatedAt DateTime @updatedAt
  
  // Normalized contacts - NOT embedded JSON for queryability
  contacts  SupplierContact[]
  
  // Audit trail link
  operationId String
  operation   OperationLog  @relation(fields: [operationId], references: [id])

  @@index([name])
  @@index([createdAt])
  @@index([operationId])
}

/// Normalized contact for a supplier.
/// 
/// DESIGN DECISIONS:
/// - Separated from Supplier to allow multiple contacts per type
/// - Channel is nullable (only used for PHONE type)
/// - isPrimary enforces only ONE primary per type per supplier (at service layer)
/// - Duplicate values across different suppliers ARE allowed (same phone, different suppliers)
/// - Duplicate values within same supplier are NOT allowed (enforced at service layer)
///
/// NOTE: type and channel are String (not enum) because SQLite doesn't support enums.
/// Valid type values: 'PHONE', 'EMAIL'
/// Valid channel values: 'REGULAR', 'WHATSAPP', 'VIBER', 'TELEGRAM', null
model SupplierContact {
  id         String   @id @default(uuid())
  supplierId String
  type       String   // 'PHONE' or 'EMAIL'
  channel    String?  // Only used when type=PHONE: 'REGULAR', 'WHATSAPP', 'VIBER', 'TELEGRAM'
  value      String   // Phone number or email address
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([type])
  @@index([value])
  @@index([supplierId, type, isPrimary])
}

// ===========================================
// PRODUCT COMPATIBILITY (RENVOI / ÉQUIVALENCE)
// ===========================================
// This domain feature allows tracking compatible/interchangeable product references.
// 
// DESIGN DECISIONS:
// 1. Compatibility is EXPLICIT - never inferred automatically
// 2. Compatibility is DIRECTIONAL - A → B does NOT imply B → A
// 3. Compatibility does NOT merge stock, pricing, or sync changes
// 4. Every relation is auditable via operationId
// 5. Soft-delete via isActive flag preserves audit trail
//
// BUSINESS RULES:
// - source_product_id ≠ target_product_id (no self-references)
// - Unique constraint on (source, target, relationType) prevents duplicates
// - Relation removal is soft-delete for auditability
//
// EDGE CASES HANDLED:
// - Circular references (A → B → A) are allowed if explicitly created
// - Multiple relation types between same products are allowed
// - Same reference from different suppliers are distinct products

/// Represents a compatibility relationship between two product references.
/// 
/// INVARIANTS:
/// - sourceProductId != targetProductId (enforced at service layer)
/// - Unique combination of (sourceProductId, targetProductId, relationType)
/// - isActive=false indicates soft-deleted (for audit trail)
model ProductCompatibility {
  id               String        @id @default(uuid())
  
  /// The originating product reference (source of the compatibility link)
  sourceProductId  String
  
  /// Target type: 'INTERNAL' or 'EXTERNAL'.
  /// NOTE: SQLite doesn't support enums; validation enforced in service layer.
  targetType       String        @default("INTERNAL")

  /// If targetType = 'INTERNAL', this references PriceEntry.id
  targetProductId  String?

  /// If targetType = 'EXTERNAL', this references ExternalProductReference.id
  externalReferenceId String?

  /// Relation field to the ExternalProductReference model when target is external
  externalReference ExternalProductReference? @relation("ExternalCompatibilities", fields: [externalReferenceId], references: [id])
  
  /// Type of compatibility relationship
  /// EQUIVALENT: Functionally identical, interchangeable
  /// SUBSTITUTE: Can be used as replacement, may have minor differences
  /// OEM_ALTERNATIVE: Alternative from different manufacturer, same specs
  relationType     String        // 'EQUIVALENT' | 'SUBSTITUTE' | 'OEM_ALTERNATIVE'
  
  /// Optional note explaining the compatibility (e.g., "Same mounting, different brand")
  note             String?
  
  /// Soft-delete flag - false means relation was removed but preserved for audit
  isActive         Boolean       @default(true)
  
  /// Audit fields
  createdAt        DateTime      @default(now())
  createdBy        String        @default("local")
  
  /// When the relation was deactivated (soft-deleted)
  deactivatedAt    DateTime?
  deactivatedBy    String?
  
  /// Link to the operation that created this relation
  operationId      String
  operation        OperationLog  @relation(fields: [operationId], references: [id])

  // Indexes for efficient querying
  @@index([sourceProductId])
  @@index([targetProductId])
  @@index([externalReferenceId])
  @@index([relationType])
  @@index([isActive])
  @@index([operationId])
  @@index([sourceProductId, isActive])
  @@index([targetProductId, isActive])
  // Unique constraints for both internal and external targets
  // Internal: unique on (sourceProductId, targetProductId, relationType)
  // External: unique on (sourceProductId, externalReferenceId, relationType)
  @@unique([sourceProductId, targetProductId, relationType])
  @@unique([sourceProductId, externalReferenceId, relationType])
}

/// External product references that do not exist as inventory items.
/// These are non-inventory, informational-only references used for compatibility knowledge.
model ExternalProductReference {
  id         String   @id @default(uuid())
  reference  String
  designation String
  brand      String
  notes      String?
  createdAt  DateTime @default(now())
  createdBy  String   @default("system")
  isActive   Boolean  @default(true)
  deactivatedAt DateTime?
  deactivatedBy String?
  // Link to operation that created this external reference (required)
  operationId String
  operation   OperationLog @relation(fields: [operationId], references: [id])

  // Back-reference for relations
  compatibilities ProductCompatibility[] @relation("ExternalCompatibilities")

  @@index([reference])
  @@index([brand])
  @@unique([reference, brand])
}

// ===========================================
// OPERATIONS LOG (AUDIT TRAIL)
// ===========================================

/// Central audit log for all data-modifying operations.
///
/// CRITICAL INVARIANTS:
/// 1. Every data modification MUST have an associated OperationLog entry
/// 2. Operation is created BEFORE any data is inserted
/// 3. Status is PENDING until all writes succeed
/// 4. An operation in PENDING status after app restart indicates a crash
/// and should prompt user for resolution (finalize or abandon)
///
/// This table is APPEND-ONLY for new operations. Only the status field
/// may be updated (PENDING->COMPLETED, COMPLETED->ABANDONED).
model OperationLog {
  id                   String       @id @default(uuid())
  /// Canonical operation type
  operationType        String
  /// Legacy operation type (kept for compatibility with existing code)
  type                 String?
  /// Entity type affected by this operation (PRODUCT|SUPPLIER|EXTERNAL_REFERENCE)
  entityType           String?
  /// ID of the primary entity affected by this operation
  entityId             String?
  /// Immutable full snapshot of the payload that caused this operation
  /// Stored as a JSON string for SQLite compatibility
  payloadSnapshot      String
  /// Status: APPLIED | ABANDONED
  status               String       @default("APPLIED")
  /// Legacy status field for compatibility (PENDING|COMPLETED|FAILED|ABANDONED)
  legacyStatus         String?      @default("COMPLETED")
  /// Optional row count for operations (kept for compatibility)
  rowCount             Int          @default(0)
  /// Optional metadata (legacy)
  metadata             String?
  description          String?
  completedAt          DateTime?
  abandonedAt          DateTime?
  abandonedBy          String?
  abandonedOperationId String?
  createdAt            DateTime     @default(now())
  createdBy            String       @default("system")
  /// Optional link to a revert operation that deactivates / reverses this operation
  revertOperationId    String?
  revertOperation      OperationLog? @relation("RevertRelation", fields: [revertOperationId], references: [id])
  /// Links back to domain rows - kept for convenience but canonical mapping is entityType/entityId
  priceEntries         PriceEntry[]
  suppliers            Supplier[]
  compatibilities      ProductCompatibility[]
  externalReferences   ExternalProductReference[]
  /// Reverse side of self-relation for revert operations
  revertedOperations   OperationLog[]     @relation("RevertRelation")

  @@index([status])
  @@index([operationType])
  @@index([type])
  @@index([createdAt])
  @@index([revertOperationId])
}
